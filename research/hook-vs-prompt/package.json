{
  "name": "hook-vs-prompt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "연구 하네스 — 지시 없음 대 프롬프트 대 PreToolUse hook (DESIGN.md)",
  "scripts": {
    "test": "tsc -p tsconfig.json && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "dryrun": "npm run build && node dist/cli.mjs run --block pilot --backend mock --out results/dryrun",
    "analyze": "node dist/cli.mjs analyze"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.269",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "vite": "7.3.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
