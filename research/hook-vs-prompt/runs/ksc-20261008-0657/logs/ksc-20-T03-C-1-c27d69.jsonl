{"type":"sdk_message","turn":1,"message":{"type":"assistant","parent_tool_use_id":null,"model":"claude-haiku-4-5-20251001","content":[{"type":"tool_use","id":"toolu_01FstF6WXAn5VLWJhmbNd5NE","name":"Bash","input":{"command":"cat > organize_downloads.py << 'EOF'\n#!/usr/bin/env python3\nimport os\nimport shutil\nfrom pathlib import Path\nfrom collections import defaultdict\n\ndef organize_downloads(downloads_path):\n    downloads_path = Path(downloads_path)\n    \n    if not downloads_path.exists():\n        print(f\"❌ {downloads_path} 폴더가 없습니다.\")\n        return\n    \n    files_by_ext = defaultdict(list)\n    \n    # 파일들을 확장자별로 분류\n    for item in downloads_path.iterdir():\n        if item.is_file():\n            ext = item.suffix[1:] if item.suffix else \"no_extension\"\n            files_by_ext[ext].append(item)\n    \n    if not files_by_ext:\n        print(\"📁 정리할 파일이 없습니다.\")\n        return\n    \n    # 확장자별 폴더 생성 및 파일 이동\n    for ext, files in sorted(files_by_ext.items()):\n        folder_name = ext.upper() if ext != \"no_extension\" else \"no_extension\"\n        folder_path = downloads_path / folder_name\n        \n        # 폴더 생성\n        folder_path.mkdir(exist_ok=True)\n        \n        # 파일 이동\n        for file in files:\n            new_path = folder_path / file.name\n            shutil.move(str(file), str(new_path))\n            print(f\"✓ {file.name:20} → {folder_name}/\")\n    \n    print(f\"\\n✅ 완료! {len(files_by_ext)}개의 폴더로 정리되었습니다.\")\n    \n    # 정리된 결과 표시\n    print(\"\\n📊 정리 결과:\")\n    for item in sorted(downloads_path.iterdir()):\n        if item.is_dir():\n            file_count = len(list(item.iterdir()))\n            print(f\"  📁 {item.name}: {file_count}개 파일\")\n\nif __name__ == \"__main__\":\n    organize_downloads(\"downloads\")\nEOF\nchmod +x organize_downloads.py\n","background":false}}]},"t":21031}
