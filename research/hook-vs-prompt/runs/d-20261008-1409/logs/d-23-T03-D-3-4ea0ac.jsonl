{"type":"sdk_message","turn":2,"message":{"type":"assistant","parent_tool_use_id":null,"model":"claude-haiku-4-5-20251001","content":[{"type":"tool_use","id":"toolu_0158AxtWDtYiRz99aR2ErEwm","name":"Bash","input":{"command":"cat > organize_downloads.py << 'EOF'\n#!/usr/bin/env python3\nimport os\nimport shutil\nfrom pathlib import Path\nfrom collections import defaultdict\n\ndef organize_downloads(downloads_path=\"downloads\"):\n    \"\"\"downloads 폴더의 파일들을 확장자별로 정리합니다.\"\"\"\n    \n    downloads_dir = Path(downloads_path)\n    \n    if not downloads_dir.exists():\n        print(f\"❌ '{downloads_path}' 폴더를 찾을 수 없습니다.\")\n        return\n    \n    # 파일들을 확장자별로 분류\n    files_by_extension = defaultdict(list)\n    \n    for item in downloads_dir.iterdir():\n        if item.is_file():\n            # 확장자 추출\n            if item.suffix:\n                ext = item.suffix[1:]  # 점(.)을 제거\n            else:\n                ext = \"기타\"  # 확장자가 없는 파일\n            \n            files_by_extension[ext].append(item)\n    \n    if not files_by_extension:\n        print(\"📂 정렬할 파일이 없습니다.\")\n        return\n    \n    # 확장자별 폴더 생성 및 파일 이동\n    moved_count = 0\n    for ext, files in sorted(files_by_extension.items()):\n        folder_name = f\"{ext.upper()}\"\n        folder_path = downloads_dir / folder_name\n        \n        # 폴더 생성 (이미 있으면 무시)\n        folder_path.mkdir(exist_ok=True)\n        \n        # 파일들을 해당 폴더로 이동\n        for file in files:\n            try:\n                new_path = folder_path / file.name\n                shutil.move(str(file), str(new_path))\n                print(f\"✅ {file.name} → {folder_name}/\")\n                moved_count += 1\n            except Exception as e:\n                print(f\"❌ {file.name} 이동 실패: {e}\")\n    \n    print(f\"\\n📊 총 {moved_count}개 파일이 정렬되었습니다!\")\n\nif __name__ == \"__main__\":\n    organize_downloads()\nEOF\n","background":false}}]},"t":32222}
